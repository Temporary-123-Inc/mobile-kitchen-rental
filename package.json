{
  "name": "mobile-kitchen-rental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node --import tsx scripts/prerender.tsx",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run --no-file-parallelism --exclude \"work/**\" tests/contact.test.ts tests/glide.test.ts tests/public-config.test.ts tests/routes.test.ts tests/import.test.mjs tests/migration.test.ts tests/legacy-url-restoration.test.ts tests/legacyVisibleImageAlt.test.ts tests/prerender-text.test.ts tests/seasonal.test.ts tests/calculator.test.ts tests/conversionAnalytics.test.ts tests/seo-live-search-performance.test.ts tests/kitchen-standards.test.tsx",
    "test:rules": "firebase emulators:exec --project demo-temporary123 --only database \"vitest run --no-file-parallelism tests/rules.test.ts\"",
    "test:e2e": "playwright test",
    "check:release": "node --import tsx scripts/release.ts",
    "check:standards": "node --import tsx scripts/check-kitchen-standards.ts",
    "check:seo": "node scripts/check-preview.mjs",
    "check:links": "node scripts/check-internal-link-casing.mjs",
    "check:headlines": "node --import tsx scripts/check-location-headlines.mjs",
    "check:cities": "node --import tsx scripts/check-city-pages.mjs",
    "optimize:location-photos": "python scripts/optimize-location-photos.py",
    "typecheck": "tsc --noEmit",
    "check:security": "python scripts/check-security-evidence.py security/security-evidence.json",
    "check:secrets": "node scripts/secret-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cheerio": "^1.2.0",
    "firebase-tools": "^14.27.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tar": "^7.5.10",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
